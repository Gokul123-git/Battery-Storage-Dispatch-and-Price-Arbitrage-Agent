            value=7,
            label="Days to show in graph",
            minimum=1,
            maximum=30,
            precision=0
        )

    run_button = gr.Button(
        "🚀 Run Forecast Evaluation",
        variant="primary"
    )

    report = gr.Markdown(
        label="Evaluation Report"
    )

    gr.Markdown(
        "### Top 10 Worst Forecast Errors"
    )

    worst_table = gr.Dataframe(
        label="Worst Errors",
        interactive=False
    )

    gr.Markdown(
        "### Actual vs Predicted"
    )

    plot = gr.Plot(
        label="Forecast Plot"
    )

    gr.Markdown(
        "### First 24-Hour Forecast"
    )

    first_day = gr.Dataframe(
        label="First 24 Hours",
        interactive=False
    )

    download_file = gr.File(
        label="Download Complete Forecast Results"
    )

    run_button.click(
        fn=evaluate_forecast,
        inputs=[
            file_input,
            days_input
        ],
        outputs=[
            report,
            worst_table,
            plot,
            download_file,
            first_day
        ]
    )


# ============================================================
# LAUNCH
# ============================================================

app.launch(
    share=True
)
